        "filter": [
            { "field": "operatingCarrierDesignator", "match": "W6", "mimeType": "internal/iata-bcbp", "scope": "Current" },
            { "field": "operatingCarrierDesignator", "match": "W4", "mimeType": "internal/iata-bcbp", "scope": "Current" },
            { "field": "operatingCarrierDesignator", "match": "W9", "mimeType": "internal/iata-bcbp", "scope": "Current" },
            { "field": "operatingCarrierDesignator", "match": "5W", "mimeType": "internal/iata-bcbp", "scope": "Current" }
        ],
        "function": "enchanceFromBCBP",

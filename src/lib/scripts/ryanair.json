        }
    ],
    "function": "fixHtmlBooking",
    "mimeType": "text/html",
    "script": "ryanair.js"
},
{
    "filter": [
        { "field": "operatingCarrierDesignator", "match": "FR", "mimeType": "internal/iata-bcbp", "scope": "Current" },
        { "field": "operatingCarrierDesignator", "match": "RR", "mimeType": "internal/iata-bcbp", "scope": "Current" },
        { "field": "operatingCarrierDesignator", "match": "AL", "mimeType": "internal/iata-bcbp", "scope": "Current" },
        { "field": "operatingCarrierDesignator", "match": "OE", "mimeType": "internal/iata-bcbp", "scope": "Current" },
        { "field": "operatingCarrierDesignator", "match": "RK", "mimeType": "internal/iata-bcbp", "scope": "Current" }
    ],
    "function": "enchanceFromBCBP",
    "mimeType": "internal/iata-bcbp",
